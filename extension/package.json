{
  "name": "aiguard",
  "displayName": "AiGuard",
  "description": "AI-powered code security guard for VS Code. Detects and fixes AI-generated code issues in real time.",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Linters",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onCommand:aiguard.showMenu",
    "onCommand:aiguard.startGuard",
    "onCommand:aiguard.pauseGuard",
    "onCommand:aiguard.scanFile",
    "onCommand:aiguard.openSettings",
    "onCommand:aiguard.viewReport",
    "onCommand:aiguard.focusSidebar",
    "onView:aiguard.sidebarView"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "aiguard.showMenu",
        "title": "AI Guard: Show Menu"
      },
      {
        "command": "aiguard.startGuard",
        "title": "AI Guard: Start Guard"
      },
      {
        "command": "aiguard.pauseGuard",
        "title": "AI Guard: Pause Guard"
      },
      {
        "command": "aiguard.scanFile",
        "title": "AI Guard: Scan Current File"
      },
      {
        "command": "aiguard.openSettings",
        "title": "AI Guard: Open Settings"
      },
      {
        "command": "aiguard.viewReport",
        "title": "AI Guard: View Report"
      },
      {
        "command": "aiguard.focusSidebar",
        "title": "AI Guard: Focus Sidebar"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "aiguard",
          "title": "AI Guard",
          "icon": "assets/aiguard.svg"
        }
      ]
    },
    "views": {
      "aiguard": [
        {
          "id": "aiguard.sidebarView",
          "name": "Guard Panel",
          "type": "webview"
        }
      ]
    },
    "configuration": {
      "title": "AI Code Guard",
      "properties": {
        "aiCodeGuard.licenseKey": {
          "type": "string",
          "default": "",
          "markdownDescription": "Your AiGuard license key. Get one at [aiguard.dev](https://aiguard.dev)."
        },
        "aiCodeGuard.maxAnalyzedChars": {
          "type": "number",
          "default": 12000,
          "minimum": 1000,
          "description": "Maximum number of characters sent for analysis per file."
        },
        "aiCodeGuard.localRules.consoleStatements": {
          "type": "boolean",
          "default": false,
          "description": "Flag console.log/warn/error statements."
        },
        "aiCodeGuard.scanMode": {
          "type": "string",
          "enum": [
            "realtime",
            "onDemand",
            "preCommit"
          ],
          "default": "realtime",
          "markdownDescription": "Scanning mode: `realtime` scans AI-generated edits after save, `onDemand` scans on command, `preCommit` reminds you to scan before committing."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.109.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2",
    "esbuild": "^0.27.3",
    "eslint": "^9.39.3",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  },
  "dependencies": {
    "@aiguard/shared": "*",
    "@babel/parser": "^7.29.0",
    "recast": "^0.23.11"
  }
}
