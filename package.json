{
  "name": "aiguard-monorepo",
  "private": true,
  "workspaces": [
    "shared",
    "extension",
    "backend"
  ],
  "scripts": {
    "build": "npm run build --workspace=shared && npm run build --workspace=extension && npm run build --workspace=backend",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run check-types --workspaces --if-present"
  },
  "devDependencies": {
    "@types/node": "^25.5.0"
  }
}
